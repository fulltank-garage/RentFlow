APP_ENV=development
APP_HOST_PORT=8080
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=rentflow
DB_PASSWORD=rentflow
DB_NAME=rentflow
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380
REDIS_URL=redis://127.0.0.1:6380/0
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# RentFlow AI (Ollama)
# Railway deploy: use your Ollama service URL, for example https://<your-ollama-service>.up.railway.app
RENTFLOW_AI_OLLAMA_URL=http://localhost:11434
RENTFLOW_AI_MODEL=qwen2.5:1.5b
# RENTFLOW_AI_BEARER_TOKEN=

# Platform admin account
RENTFLOW_SUPER_ADMIN_USERNAME=your-admin-username
RENTFLOW_SUPER_ADMIN_EMAIL=admin@example.com
# Set this in Railway variables or local .env, do not commit real production passwords.
RENTFLOW_SUPER_ADMIN_PASSWORD=change-me
RENTFLOW_SUPER_ADMIN_FIRST_NAME=Platform
RENTFLOW_SUPER_ADMIN_LAST_NAME=Admin

# Optional production defaults
# RENTFLOW_DEFAULT_TENANT_ID=
RENTFLOW_PLAN_PRICE_STARTER=0
RENTFLOW_PLAN_PRICE_GROWTH=990
RENTFLOW_PLAN_PRICE_ENTERPRISE=2990
